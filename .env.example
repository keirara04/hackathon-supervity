# ===================================================================
#      AUTOPILOT COMMAND CENTER - ENVIRONMENT CONFIGURATION
# -------------------------------------------------------------------
#  Copy this file to .env to get started (cp .env.example .env).
#  Database/frontend defaults below work out of the box, but SUPABASE_URL
#  and SUPABASE_KEY further down are REQUIRED — the app boots without
#  them but every page will fail. See the SUPABASE section below.
# ===================================================================

# ------------------------------------------------------------
# BACKEND
# ------------------------------------------------------------
APP_ENV=development
FRONTEND_URL=http://localhost:8080
LOG_LEVEL=INFO

# Auth bypass — all requests auto-authenticated as Dev User (admin role)
AUTH_BYPASS=true

# ------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=app_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ------------------------------------------------------------
# FRONTEND
# ------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_BASE_PATH=

# NextAuth (required for session management even with AUTH_BYPASS)
NEXTAUTH_URL=http://localhost:8080

# REQUIRED: A secret used to sign and encrypt NextAuth.js tokens.
# Generate with:
#   macOS/Linux: openssl rand -base64 32
#   Windows:     [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Minimum 0 -Maximum 256 }))
NEXTAUTH_SECRET=

# ------------------------------------------------------------
# DOCKER
# ------------------------------------------------------------
# "dev" = hot reload | "prod" = optimized build
FRONTEND_TARGET=dev

# ------------------------------------------------------------
# SUPABASE — REQUIRED. All business data (run_log, policy_config,
# workbench_tasks, triage_queue, kb_articles, incidents, users_directory,
# assets_access) lives here, not in the Postgres above. Without these two
# values every Command Center page fails — this is not optional.
# Get the project URL + service key from the team (project ovtxhlpeixfjyyxqufhw).
# ------------------------------------------------------------
SUPABASE_URL=
SUPABASE_KEY=

# ------------------------------------------------------------
# OPENROUTER — powers the AI Manager chat and AI Insights synthesis/
# diagnosis. Optional: those features just degrade to "not configured"
# without it, nothing else breaks.
# ------------------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4-flash

# ------------------------------------------------------------
# ZENDESK — OAuth client-credentials. Optional: only needed for the
# Data Manager Zendesk health check and the live /zendesk-tickets
# viewer/import; everything else works without it.
# ------------------------------------------------------------
ZENDESK_SUBDOMAIN=
ZENDESK_CLIENT_ID=
ZENDESK_CLIENT_SECRET=
ZENDESK_TOKEN_URL=

# ------------------------------------------------------------
# AUTO ORCHESTRATOR (auto.supervity.ai) — lets the AI Manager's trigger
# tool kick off a real workflow-runs/execute/stream run. Optional: the
# trigger tool just reports "not configured" without it.
# ------------------------------------------------------------
AUTO_WORKFLOW_API_KEY=
AUTO_WORKFLOW_ID=
AUTO_USER_TIMEZONE=Asia/Kuala_Lumpur
AUTO_SLACK_CHANNEL=it-help-desk
